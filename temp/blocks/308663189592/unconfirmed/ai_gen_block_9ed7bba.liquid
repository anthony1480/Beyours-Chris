{% doc %}
  @prompt
    Create a "Coming Soon" announcement banner for the Bundles collection page. It should have a bold heading like "New Bundles Coming Soon", a short supporting line such as "Stay tuned — exciting new bundle deals are on their way", and a clean, premium look with a neutral warm-toned background that matches a white/dark-text bedding brand aesthetic. No countdown timer needed. The banner should be simple, elegant, and full-width.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-coming-soon-banner-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.vertical_padding }}px {{ block.settings.horizontal_padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: {{ block.settings.alignment }};
    border-top: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    border-bottom: {{ block.settings.border_width }}px solid {{ block.settings.border_color }};
    box-sizing: border-box;
  }

  .ai-coming-soon-banner-{{ ai_gen_id }}__inner {
    width: 100%;
    max-width: 900px;
    margin: 0 auto;
  }

  .ai-coming-soon-banner-{{ ai_gen_id }}__heading {
    margin: 0 0 10px;
    color: {{ block.settings.heading_color }};
    font-family: inherit;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.01em;
  }

  .ai-coming-soon-banner-{{ ai_gen_id }}__message {
    margin: 0;
    color: {{ block.settings.text_color }};
    font-family: inherit;
    font-size: {{ block.settings.message_size }}px;
    line-height: 1.5;
  }

  @media screen and (max-width: 749px) {
    .ai-coming-soon-banner-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.mobile_vertical_padding }}px {{ block.settings.mobile_horizontal_padding }}px;
    }

    .ai-coming-soon-banner-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-coming-soon-banner-{{ ai_gen_id }}__message {
      font-size: {{ block.settings.mobile_message_size }}px;
    }
  }
{% endstyle %}

<div
  class="ai-coming-soon-banner-{{ ai_gen_id }}"
  role="status"
  aria-label="{{ block.settings.heading | escape }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-coming-soon-banner-{{ ai_gen_id }}__inner">
    <h2 class="ai-coming-soon-banner-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
    <p class="ai-coming-soon-banner-{{ ai_gen_id }}__message">{{ block.settings.message | escape }}</p>
  </div>
</div>

{% schema %}
{
  "name": "Coming soon banner",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "New Bundles Coming Soon"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Supporting line",
      "default": "Stay tuned — exciting new bundle deals are on their way"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3EEE7"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#1A1B18"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#212326"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#D8CEC2"
    },
    {
      "type": "header",
      "content": "Spacing and type"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size",
      "min": 18,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 30
    },
    {
      "type": "range",
      "id": "message_size",
      "label": "Message size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "Vertical padding",
      "min": 12,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "horizontal_padding",
      "label": "Horizontal padding",
      "min": 16,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "border_width",
      "label": "Border width",
      "min": 0,
      "max": 4,
      "step": 1,
      "unit": "px",
      "default": 1
    },
    {
      "type": "range",
      "id": "mobile_heading_size",
      "label": "Mobile heading size",
      "min": 16,
      "max": 36,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_message_size",
      "label": "Mobile message size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "mobile_vertical_padding",
      "label": "Mobile vertical padding",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "mobile_horizontal_padding",
      "label": "Mobile horizontal padding",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Coming soon banner"
    }
  ],
  "tag": null,
  "class": "coming-soon-banner-block"
}
{% endschema %}