{% doc %}
  @prompt
    generate a bundle and save 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-bundle-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.padding }}px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    border: 1px solid {{ block.settings.border_color }};
  }

  .ai-bundle__inner-{{ ai_gen_id }} {
    max-width: 1100px;
    margin: 0 auto;
  }

  .ai-bundle__heading-{{ ai_gen_id }} {
    margin: 0 0 8px;
    color: {{ block.settings.heading_color }};
    font-size: {{ block.settings.heading_size }}px;
    text-align: {{ block.settings.alignment }};
  }

  .ai-bundle__intro-{{ ai_gen_id }} {
    margin: 0 0 24px;
    text-align: {{ block.settings.alignment }};
    line-height: 1.6;
  }

  .ai-bundle__products-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns }}, minmax(0, 1fr));
    gap: 16px;
  }

  .ai-bundle__product-{{ ai_gen_id }} {
    min-width: 0;
  }

  .ai-bundle__image-{{ ai_gen_id }} {
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: {{ block.settings.image_background }};
  }

  .ai-bundle__image-{{ ai_gen_id }} img,
  .ai-bundle__image-{{ ai_gen_id }} svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-bundle__details-{{ ai_gen_id }} {
    padding-top: 10px;
  }

  .ai-bundle__title-{{ ai_gen_id }} {
    margin: 0 0 5px;
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    line-height: 1.35;
  }

  .ai-bundle__price-{{ ai_gen_id }} {
    color: {{ block.settings.price_color }};
    font-size: 14px;
  }

  .ai-bundle__footer-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-top: 28px;
  }

  .ai-bundle__total-{{ ai_gen_id }} {
    color: {{ block.settings.heading_color }};
    font-size: 16px;
    font-weight: 600;
  }

  .ai-bundle__button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 12px 24px;
    border: {{ block.settings.button_border_width }}px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    background: {{ block.settings.button_color }};
    color: {{ block.settings.button_text_color }};
    cursor: pointer;
    font: inherit;
    font-size: 14px;
    text-decoration: none;
  }

  .ai-bundle__button-{{ ai_gen_id }}:hover {
    opacity: 0.88;
  }

  .ai-bundle__button-{{ ai_gen_id }}:focus-visible {
    outline: 3px solid {{ block.settings.focus_color }};
    outline-offset: 3px;
  }

  .ai-bundle__message-{{ ai_gen_id }} {
    margin-top: 14px;
    color: {{ block.settings.text_color }};
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-bundle-{{ ai_gen_id }} {
      width: 100%;
      padding: {{ block.settings.mobile_padding }}px;
    }

    .ai-bundle__products-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .ai-bundle__footer-{{ ai_gen_id }} {
      align-items: stretch;
      flex-direction: column;
    }

    .ai-bundle__button-{{ ai_gen_id }} {
      width: 100%;
    }
  }
{% endstyle %}

<bundle-offer-{{ ai_gen_id }} class="ai-bundle-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-bundle__inner-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-bundle__heading-{{ ai_gen_id }}">{{ block.settings.heading | escape }}</h2>
    {% endif %}

    {% if block.settings.intro != blank %}
      <div class="ai-bundle__intro-{{ ai_gen_id }}">{{ block.settings.intro }}</div>
    {% endif %}

    {% if block.settings.products != blank %}
      <div class="ai-bundle__products-{{ ai_gen_id }}">
        {% for product in block.settings.products %}
          {% assign bundle_variant = product.selected_or_first_available_variant %}
          <article class="ai-bundle__product-{{ ai_gen_id }}" data-variant-id="{{ bundle_variant.id }}">
            <a href="{{ product.url }}" aria-label="{{ product.title | escape }}">
              <div class="ai-bundle__image-{{ ai_gen_id }}">
                {% if product.featured_image %}
                  <img src="{{ product.featured_image | image_url: width: 700 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="700" height="700">
                {% else %}
                  {{ 'product-apparel-1' | placeholder_svg_tag }}
                {% endif %}
              </div>
            </a>
            <div class="ai-bundle__details-{{ ai_gen_id }}">
              <h3 class="ai-bundle__title-{{ ai_gen_id }}">{{ product.title | escape }}</h3>
              <div class="ai-bundle__price-{{ ai_gen_id }}">{{ bundle_variant.price | money }}</div>
            </div>
          </article>
        {% endfor %}
      </div>

      <div class="ai-bundle__footer-{{ ai_gen_id }}">
        <div class="ai-bundle__total-{{ ai_gen_id }}">{{ block.settings.total_label | escape }}</div>
        <button type="button" class="ai-bundle__button-{{ ai_gen_id }}">{{ block.settings.button_label | escape }}</button>
      </div>
      <div class="ai-bundle__message-{{ ai_gen_id }}" role="status" aria-live="polite"></div>
    {% else %}
      <div class="ai-bundle__message-{{ ai_gen_id }}">Select products to create your bundle.</div>
    {% endif %}
  </div>
</bundle-offer-{{ ai_gen_id }}>

<script>
  (function() {
    class BundleOffer{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.button = this.querySelector('.ai-bundle__button-{{ ai_gen_id }}');
        this.message = this.querySelector('.ai-bundle__message-{{ ai_gen_id }}');
        if (this.button) this.button.addEventListener('click', () => this.addBundle());
      }

      async addBundle() {
        const items = Array.from(this.querySelectorAll('[data-variant-id]')).map((item) => ({
          id: Number(item.dataset.variantId),
          quantity: 1
        }));
        if (!items.length) return;
        this.button.disabled = true;
        this.message.textContent = 'Adding bundle…';
        try {
          const response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify({ items: items })
          });
          if (!response.ok) throw new Error('Unable to add bundle');
          this.message.textContent = '{{ block.settings.success_message | escape }}';
          document.dispatchEvent(new CustomEvent('cart:refresh'));
        } catch (error) {
          this.message.textContent = '{{ block.settings.error_message | escape }}';
        } finally {
          this.button.disabled = false;
        }
      }
    }
    if (!customElements.get('bundle-offer-{{ ai_gen_id }}')) customElements.define('bundle-offer-{{ ai_gen_id }}', BundleOffer{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Bundle offer",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Complete the look" },
    { "type": "richtext", "id": "intro", "label": "Intro", "default": "<p>Pair these pieces together for a considered finish.</p>" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 4 },
    { "type": "text", "id": "total_label", "label": "Total label", "default": "Add the full bundle" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Add bundle to cart" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Bundle added to cart." },
    { "type": "text", "id": "error_message", "label": "Error message", "default": "Please try again or add the products individually." },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "columns", "label": "Columns", "options": [{ "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }], "default": "4" },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "range", "id": "padding", "label": "Desktop padding", "min": 16, "max": 80, "step": 4, "unit": "px", "default": 40 },
    { "type": "range", "id": "mobile_padding", "label": "Mobile padding", "min": 12, "max": 40, "step": 4, "unit": "px", "default": 20 },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 28 },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f6f3ee" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#ebe7df" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a1b18" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#212326" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#1a1b18" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#d2d5d9" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#1a1b18" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#315f9b" },
    { "type": "range", "id": "button_border_width", "label": "Button border", "min": 0, "max": 4, "step": 1, "unit": "px", "default": 1 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Bundle offer" }],
  "tag": null,
  "class": "bundle-offer-block"
}
{% endschema %}