{% doc %}
  @prompt
    Update the existing homepage slideshow's Image slide so it can display a second customizable button directly beneath the current “Discover the Collection” button on the same slide. Give the second button its own editable label and destination link, and keep its appearance consistent with the existing button. Preserve the current slide image, text, and existing button.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-slide-secondary-cta-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    text-align: center;
  }

  .ai-slide-secondary-cta-{{ ai_gen_id }}__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: auto;
    max-width: 100%;
    text-decoration: none;
  }

  .ai-slide-secondary-cta-{{ ai_gen_id }}__link:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 3px;
  }
{% endstyle %}

<div class="ai-slide-secondary-cta-{{ ai_gen_id }}" style="width: {{ block.settings.desktop_width_percent }}%;" {{ block.shopify_attributes }}>
  {% if block.settings.button_label != blank and block.settings.button_link != blank %}
    <a class="ai-slide-secondary-cta-{{ ai_gen_id }}__link button button--primary" href="{{ block.settings.button_link }}">
      {{ block.settings.button_label | escape }}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "Slide secondary button",
  "settings": [
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Explore more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button destination"
    },
    {
      "type": "range",
      "id": "desktop_width_percent",
      "label": "Desktop width",
      "min": 50,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 100
    }
  ],
  "presets": [
    {
      "name": "Slide secondary button"
    }
  ],
  "tag": null,
  "class": "slide-secondary-button"
}
{% endschema %}