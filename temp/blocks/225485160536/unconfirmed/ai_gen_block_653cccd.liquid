{% doc %}
  @prompt
    Create a discount roulette spin wheel block with weighted probability odds. The wheel should have 3 prize segments: 5% off (60% chance, discount code WELCOME5, color #faeaa1), 10% off (30% chance, discount code WELCOME10, color #d8c58a), and 15% off (10% chance, discount code WELCOME15, color #b8a46b). The spin animation should land on a segment based on the weighted probability, then display the winning discount code for the customer to copy. Eyebrow: 'A welcome gift', heading: 'Spin for a special saving', description: 'Take a spin and receive one of our welcome offers from Softex Linens.', button label: 'Spin the wheel', note: 'Offer codes are subject to the terms configured in Shopify.', we need it as a ppopup, we need it to appear when peopleopen the website, okay justt make it a  roulette and the arrow fixed on the top and the thing that lands on the top is the discount and hide the odds, okay keep everything as it is but remove whats inside the roulette
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}.ai-roulette-popup-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%}.ai-roulette-popup__overlay-{{ ai_gen_id }}{position:fixed;inset:0;z-index:1000;background:#212326b8;display:flex;align-items:center;justify-content:center;padding:20px}.ai-roulette-popup__overlay-{{ ai_gen_id }}.is-hidden{display:none}.ai-roulette-popup__dialog-{{ ai_gen_id }}{position:relative;width:min(560px,100%);max-height:90vh;overflow:auto;padding:38px 28px;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};border-radius:{{ block.settings.radius }}px;text-align:center;box-shadow:0 18px 50px #0004}.ai-roulette-popup__close-{{ ai_gen_id }}{position:absolute;right:14px;top:8px;border:0;background:none;font-size:28px;color:{{ block.settings.heading_color }};cursor:pointer}.ai-roulette-popup__eyebrow-{{ ai_gen_id }}{color:{{ block.settings.accent_color }};font-size:12px;letter-spacing:.15em;text-transform:uppercase;font-weight:700}.ai-roulette-popup__heading-{{ ai_gen_id }}{font-family:{{ block.settings.heading_font.family }};color:{{ block.settings.heading_color }};font-size:clamp(28px,5vw,42px);margin:10px 0}.ai-roulette-popup__description-{{ ai_gen_id }}{line-height:1.6}.ai-roulette-popup__stage-{{ ai_gen_id }}{position:relative;width:min(320px,80vw);margin:26px auto 20px}.ai-roulette-popup__pointer-{{ ai_gen_id }}{position:absolute;z-index:3;top:-13px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:15px solid transparent;border-right:15px solid transparent;border-top:30px solid {{ block.settings.heading_color }}}.ai-roulette-popup__wheel-{{ ai_gen_id }}{position:relative;width:100%;aspect-ratio:1;border:8px solid {{ block.settings.heading_color }};border-radius:50%;background:conic-gradient({{ block.settings.segment_one_color }} 0deg 216deg,{{ block.settings.segment_two_color }} 216deg 324deg,{{ block.settings.segment_three_color }} 324deg 360deg);transition:transform 4s cubic-bezier(.12,.72,.15,1)}.ai-roulette-popup__labels-{{ ai_gen_id }}{display:none}.ai-roulette-popup__center-{{ ai_gen_id }}{position:absolute;left:50%;top:50%;width:42px;height:42px;transform:translate(-50%,-50%);border-radius:50%;background:{{ block.settings.heading_color }};border:5px solid {{ block.settings.background_color }}}.ai-roulette-popup__spin-{{ ai_gen_id }}{padding:14px 24px;border:0;border-radius:{{ block.settings.button_radius }}px;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};font:inherit;font-weight:700;cursor:pointer}.ai-roulette-popup__spin-{{ ai_gen_id }}:disabled{opacity:.6}.ai-roulette-popup__result-{{ ai_gen_id }}{min-height:52px;margin-top:16px}.ai-roulette-popup__code-{{ ai_gen_id }}{display:inline-block;margin-top:7px;padding:8px 12px;border:1px dashed {{ block.settings.accent_color }};font-weight:700;letter-spacing:.08em}.ai-roulette-popup__copy-{{ ai_gen_id }}{margin-left:8px;border:0;background:none;text-decoration:underline;cursor:pointer;color:{{ block.settings.heading_color }}}.ai-roulette-popup__note-{{ ai_gen_id }}{font-size:12px;opacity:.75}{% endstyle %}
<discount-roulette-popup-{{ ai_gen_id }} class="ai-roulette-popup-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-roulette-popup__overlay-{{ ai_gen_id }}" role="dialog" aria-modal="true"><div class="ai-roulette-popup__dialog-{{ ai_gen_id }}"><button class="ai-roulette-popup__close-{{ ai_gen_id }}" type="button" aria-label="Close">&times;</button><div class="ai-roulette-popup__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div><h2 class="ai-roulette-popup__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2><p class="ai-roulette-popup__description-{{ ai_gen_id }}">{{ block.settings.description }}</p><div class="ai-roulette-popup__stage-{{ ai_gen_id }}"><span class="ai-roulette-popup__pointer-{{ ai_gen_id }}" aria-hidden="true"></span><div class="ai-roulette-popup__wheel-{{ ai_gen_id }}"><span class="ai-roulette-popup__center-{{ ai_gen_id }}"></span></div></div><button class="ai-roulette-popup__spin-{{ ai_gen_id }}" type="button">{{ block.settings.button_label }}</button><div class="ai-roulette-popup__result-{{ ai_gen_id }}" aria-live="polite"></div><p class="ai-roulette-popup__note-{{ ai_gen_id }}">{{ block.settings.note }}</p></div></div></discount-roulette-popup-{{ ai_gen_id }}>
<script>(function(){class R{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.o=this.querySelector('.ai-roulette-popup__overlay-{{ ai_gen_id }}');this.w=this.querySelector('.ai-roulette-popup__wheel-{{ ai_gen_id }}');this.b=this.querySelector('.ai-roulette-popup__spin-{{ ai_gen_id }}');this.r=this.querySelector('.ai-roulette-popup__result-{{ ai_gen_id }}');this.n=0;this.querySelector('.ai-roulette-popup__close-{{ ai_gen_id }}').onclick=()=>this.o.classList.add('is-hidden');this.b.onclick=()=>{if(this.b.disabled)return;this.b.disabled=true;let x=Math.random()*100,p,c,s;if(x<60){p='{{ block.settings.prize_one | escape }}';c='{{ block.settings.prize_one_code | escape }}';s=288}else if(x<90){p='{{ block.settings.prize_two | escape }}';c='{{ block.settings.prize_two_code | escape }}';s=234}else{p='{{ block.settings.prize_three | escape }}';c='{{ block.settings.prize_three_code | escape }}';s=198}this.n+=1440+((360-s-this.n%360+360)%360);this.w.style.transform='rotate('+this.n+'deg)';setTimeout(()=>{this.r.innerHTML='<strong>You won '+p+'!</strong><br><span class="ai-roulette-popup__code-{{ ai_gen_id }}">'+c+'</span><button class="ai-roulette-popup__copy-{{ ai_gen_id }}">Copy code</button>';this.r.querySelector('button').onclick=()=>navigator.clipboard.writeText(c);this.b.disabled=false},4100)}}}customElements.define('discount-roulette-popup-{{ ai_gen_id }}',R{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Welcome roulette popup","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A welcome gift"},{"type":"text","id":"heading","label":"Heading","default":"Spin for a special saving"},{"type":"textarea","id":"description","label":"Description","default":"Take a spin and receive one of our welcome offers from Softex Linens."},{"type":"text","id":"button_label","label":"Button label","default":"Spin the wheel"},{"type":"textarea","id":"note","label":"Note","default":"Offer codes are subject to the terms configured in Shopify."},{"type":"header","content":"Offers"},{"type":"text","id":"prize_one","label":"First prize","default":"5% off"},{"type":"text","id":"prize_one_code","label":"First code","default":"WELCOME5"},{"type":"color","id":"segment_one_color","label":"First segment","default":"#faeaa1"},{"type":"text","id":"prize_two","label":"Second prize","default":"10% off"},{"type":"text","id":"prize_two_code","label":"Second code","default":"WELCOME10"},{"type":"color","id":"segment_two_color","label":"Second segment","default":"#d8c58a"},{"type":"text","id":"prize_three","label":"Third prize","default":"15% off"},{"type":"text","id":"prize_three_code","label":"Third code","default":"WELCOME15"},{"type":"color","id":"segment_three_color","label":"Third segment","default":"#b8a46b"},{"type":"header","content":"Style"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"arvo_n4"},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#212326"},{"type":"color","id":"heading_color","label":"Heading","default":"#1a1b18"},{"type":"color","id":"accent_color","label":"Accent","default":"#1a1b18"},{"type":"color","id":"button_color","label":"Button","default":"#1a1b18"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":40,"step":2,"unit":"px","default":0},{"type":"range","id":"radius","label":"Popup radius","min":0,"max":40,"step":2,"unit":"px","default":8},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Welcome roulette popup"}],"tag":null,"class":"welcome-roulette-popup-block"}{% endschema %}