{% doc %}
  @prompt
    Create a discount roulette spin wheel block with weighted probability odds. The wheel should have 3 prize segments: 5% off (60% chance, discount code WELCOME5, color #faeaa1), 10% off (30% chance, discount code WELCOME10, color #d8c58a), and 15% off (10% chance, discount code WELCOME15, color #b8a46b). The spin animation should land on a segment based on the weighted probability, then display the winning discount code for the customer to copy. Eyebrow: 'A welcome gift', heading: 'Spin for a special saving', description: 'Take a spin and receive one of our welcome offers from Softex Linens.', button label: 'Spin the wheel', note: 'Offer codes are subject to the terms configured in Shopify.'
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-roulette-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    color: {{ block.settings.text_color }};
    background: {{ block.settings.background_color }};
    padding: 42px 24px;
    box-sizing: border-box;
  }

  .ai-roulette__inner-{{ ai_gen_id }} {
    max-width: 980px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(260px, 390px) minmax(0, 1fr);
    align-items: center;
    gap: 52px;
  }

  .ai-roulette__copy-{{ ai_gen_id }} { text-align: {{ block.settings.alignment }}; }
  .ai-roulette__eyebrow-{{ ai_gen_id }} { margin: 0 0 12px; color: {{ block.settings.accent_color }}; font-size: 12px; letter-spacing: .16em; text-transform: uppercase; font-weight: 700; }
  .ai-roulette__heading-{{ ai_gen_id }} { margin: 0 0 14px; color: {{ block.settings.heading_color }}; font-family: {{ block.settings.heading_font.family }}; font-size: clamp(28px, 4vw, 46px); line-height: 1.08; }
  .ai-roulette__description-{{ ai_gen_id }} { margin: 0 0 24px; font-size: 16px; line-height: 1.6; }
  .ai-roulette__note-{{ ai_gen_id }} { margin: 16px 0 0; font-size: 12px; line-height: 1.5; opacity: .75; }
  .ai-roulette__button-{{ ai_gen_id }} { border: 1px solid {{ block.settings.button_color }}; background: {{ block.settings.button_color }}; color: {{ block.settings.button_text_color }}; padding: 13px 24px; border-radius: {{ block.settings.button_radius }}px; font: inherit; font-weight: 700; cursor: pointer; }
  .ai-roulette__button-{{ ai_gen_id }}:focus-visible, .ai-roulette__copy-button-{{ ai_gen_id }}:focus-visible { outline: 3px solid {{ block.settings.focus_color }}; outline-offset: 3px; }
  .ai-roulette__button-{{ ai_gen_id }}:disabled { opacity: .6; cursor: wait; }
  .ai-roulette__wheel-area-{{ ai_gen_id }} { display: flex; flex-direction: column; align-items: center; gap: 22px; }
  .ai-roulette__wheel-wrap-{{ ai_gen_id }} { position: relative; width: min(100%, 360px); aspect-ratio: 1; }
  .ai-roulette__wheel-{{ ai_gen_id }} { width: 100%; height: 100%; border-radius: 50%; border: 8px solid {{ block.settings.wheel_border_color }}; background: conic-gradient(from -30deg, {{ block.settings.segment_one_color }} 0deg 216deg, {{ block.settings.segment_two_color }} 216deg 324deg, {{ block.settings.segment_three_color }} 324deg 360deg); box-shadow: 0 8px 22px rgba(33,35,38,.16); transition: transform 4s cubic-bezier(.12,.72,.15,1); }
  .ai-roulette__labels-{{ ai_gen_id }} { position: absolute; inset: 0; pointer-events: none; }
  .ai-roulette__label-{{ ai_gen_id }} { position: absolute; left: 50%; top: 50%; width: 32%; transform-origin: 0 0; text-align: center; font-weight: 700; font-size: 15px; color: #212326; }
  .ai-roulette__label--one-{{ ai_gen_id }} { transform: rotate(48deg) translate(72px, -50%); }
  .ai-roulette__label--two-{{ ai_gen_id }} { transform: rotate(264deg) translate(72px, -50%); }
  .ai-roulette__label--three-{{ ai_gen_id }} { transform: rotate(336deg) translate(72px, -50%); }
  .ai-roulette__pointer-{{ ai_gen_id }} { position: absolute; z-index: 2; top: -12px; left: 50%; transform: translateX(-50%); width: 0; height: 0; border-left: 14px solid transparent; border-right: 14px solid transparent; border-top: 28px solid {{ block.settings.pointer_color }}; }
  .ai-roulette__result-{{ ai_gen_id }} { width: min(100%, 360px); text-align: center; min-height: 60px; }
  .ai-roulette__result-title-{{ ai_gen_id }} { margin: 0 0 7px; font-size: 15px; font-weight: 700; }
  .ai-roulette__code-row-{{ ai_gen_id }} { display: flex; align-items: center; justify-content: center; gap: 8px; }
  .ai-roulette__code-{{ ai_gen_id }} { padding: 8px 12px; border: 1px dashed {{ block.settings.accent_color }}; font-weight: 700; letter-spacing: .08em; }
  .ai-roulette__copy-button-{{ ai_gen_id }} { border: 0; background: transparent; color: {{ block.settings.heading_color }}; text-decoration: underline; cursor: pointer; font: inherit; font-size: 13px; }
  @media screen and (max-width: 749px) { .ai-roulette__inner-{{ ai_gen_id }} { grid-template-columns: 1fr; gap: 32px; } .ai-roulette__copy-{{ ai_gen_id }} { text-align: center; } }
{% endstyle %}

<discount-roulette-{{ ai_gen_id }} class="ai-roulette-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-roulette__inner-{{ ai_gen_id }}">
    <div class="ai-roulette__copy-{{ ai_gen_id }}">
      <p class="ai-roulette__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p>
      <h2 class="ai-roulette__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      <p class="ai-roulette__description-{{ ai_gen_id }}">{{ block.settings.description }}</p>
      <button type="button" class="ai-roulette__button-{{ ai_gen_id }}">{{ block.settings.button_label }}</button>
      <p class="ai-roulette__note-{{ ai_gen_id }}">{{ block.settings.note }}</p>
    </div>
    <div class="ai-roulette__wheel-area-{{ ai_gen_id }}">
      <div class="ai-roulette__wheel-wrap-{{ ai_gen_id }}">
        <div class="ai-roulette__pointer-{{ ai_gen_id }}" aria-hidden="true"></div>
        <div class="ai-roulette__wheel-{{ ai_gen_id }}" aria-label="Discount prize wheel"></div>
        <div class="ai-roulette__labels-{{ ai_gen_id }}" aria-hidden="true">
          <span class="ai-roulette__label-{{ ai_gen_id }} ai-roulette__label--one-{{ ai_gen_id }}">{{ block.settings.prize_one }}</span>
          <span class="ai-roulette__label-{{ ai_gen_id }} ai-roulette__label--two-{{ ai_gen_id }}">{{ block.settings.prize_two }}</span>
          <span class="ai-roulette__label-{{ ai_gen_id }} ai-roulette__label--three-{{ ai_gen_id }}">{{ block.settings.prize_three }}</span>
        </div>
      </div>
      <div class="ai-roulette__result-{{ ai_gen_id }}" aria-live="polite"></div>
    </div>
  </div>
</discount-roulette-{{ ai_gen_id }}>

<script>
  (function() {
    class DiscountRoulette{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.button = this.querySelector('.ai-roulette__button-{{ ai_gen_id }}');
        this.wheel = this.querySelector('.ai-roulette__wheel-{{ ai_gen_id }}');
        this.result = this.querySelector('.ai-roulette__result-{{ ai_gen_id }}');
        this.rotation = 0;
        this.button.addEventListener('click', () => this.spin());
      }
      spin() {
        if (this.button.disabled) return;
        this.button.disabled = true;
        const value = Math.random() * 100;
        let prize;
        let target;
        if (value < {{ block.settings.prize_one_weight }}) { prize = '{{ block.settings.prize_one | escape }}'; target = '{{ block.settings.prize_one_code | escape }}'; }
        else if (value < {{ block.settings.prize_one_weight | plus: block.settings.prize_two_weight }}) { prize = '{{ block.settings.prize_two | escape }}'; target = '{{ block.settings.prize_two_code | escape }}'; }
        else { prize = '{{ block.settings.prize_three | escape }}'; target = '{{ block.settings.prize_three_code | escape }}'; }
        const segment = prize === '{{ block.settings.prize_one | escape }}' ? 108 : prize === '{{ block.settings.prize_two | escape }}' ? 270 : 342;
        this.rotation += 1440 + (360 - ((this.rotation + segment) % 360));
        this.wheel.style.transform = 'rotate(' + this.rotation + 'deg)';
        setTimeout(() => { this.result.innerHTML = '<p class="ai-roulette__result-title-{{ ai_gen_id }}">You won ' + prize + '!</p><div class="ai-roulette__code-row-{{ ai_gen_id }}"><span class="ai-roulette__code-{{ ai_gen_id }}">' + target + '</span><button type="button" class="ai-roulette__copy-button-{{ ai_gen_id }}">Copy code</button></div>'; this.result.querySelector('button').addEventListener('click', () => navigator.clipboard.writeText(target)); this.button.disabled = false; }, 4100);
      }
    }
    customElements.define('discount-roulette-{{ ai_gen_id }}', DiscountRoulette{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Discount roulette",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A welcome gift" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spin for a special saving" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Take a spin and receive one of our welcome offers from Softex Linens." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Spin the wheel" },
    { "type": "textarea", "id": "note", "label": "Note", "default": "Offer codes are subject to the terms configured in Shopify." },
    { "type": "header", "content": "Offers" },
    { "type": "text", "id": "prize_one", "label": "First prize", "default": "5% off" },
    { "type": "text", "id": "prize_one_code", "label": "First code", "default": "WELCOME5" },
    { "type": "range", "id": "prize_one_weight", "label": "First chance", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 60 },
    { "type": "color", "id": "segment_one_color", "label": "First segment", "default": "#faeaa1" },
    { "type": "text", "id": "prize_two", "label": "Second prize", "default": "10% off" },
    { "type": "text", "id": "prize_two_code", "label": "Second code", "default": "WELCOME10" },
    { "type": "range", "id": "prize_two_weight", "label": "Second chance", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 30 },
    { "type": "color", "id": "segment_two_color", "label": "Second segment", "default": "#d8c58a" },
    { "type": "text", "id": "prize_three", "label": "Third prize", "default": "15% off" },
    { "type": "text", "id": "prize_three_code", "label": "Third code", "default": "WELCOME15" },
    { "type": "range", "id": "prize_three_weight", "label": "Third chance", "min": 0, "max": 100, "step": 5, "unit": "%", "default": 10 },
    { "type": "color", "id": "segment_three_color", "label": "Third segment", "default": "#b8a46b" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "select", "id": "alignment", "label": "Alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "arvo_n4" },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#212326" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a1b18" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1a1b18" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#1a1b18" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "wheel_border_color", "label": "Wheel border", "default": "#1a1b18" },
    { "type": "color", "id": "pointer_color", "label": "Pointer", "default": "#1a1b18" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#216869" },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "Discount roulette" }],
  "tag": null,
  "class": "discount-roulette-block"
}
{% endschema %}