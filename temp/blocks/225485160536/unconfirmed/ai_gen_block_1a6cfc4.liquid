{% doc %}
  @prompt
    a discount roulette pop-up that appears the second the customers open the website
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-discount-roulette-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__backdrop {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: {{ block.settings.overlay_color }};
  }

  .ai-discount-roulette-{{ ai_gen_id }}__modal {
    position: relative;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 560px;
    max-height: calc(100vh - 40px);
    overflow: auto;
    padding: 34px 28px 30px;
    background: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    text-align: center;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: {{ block.settings.corner_radius }}px;
    box-shadow: 0 18px 60px rgba(0, 0, 0, 0.22);
  }

  .ai-discount-roulette-{{ ai_gen_id }}__close {
    position: absolute;
    top: 12px;
    right: 14px;
    width: 36px;
    height: 36px;
    padding: 0;
    color: {{ block.settings.text_color }};
    background: transparent;
    border: 1px solid {{ block.settings.border_color }};
    border-radius: 50%;
    cursor: pointer;
    font-size: 24px;
    line-height: 1;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__eyebrow {
    margin: 0 0 8px;
    color: {{ block.settings.accent_color }};
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__heading {
    margin: 0 0 10px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: 30px;
    line-height: 1.15;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__copy {
    max-width: 430px;
    margin: 0 auto 22px;
    font-size: 15px;
    line-height: 1.55;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__wheel-wrap {
    position: relative;
    width: min(280px, 80vw);
    aspect-ratio: 1;
    margin: 0 auto 22px;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__wheel {
    width: 100%;
    height: 100%;
    border: 8px solid {{ block.settings.accent_color }};
    border-radius: 50%;
    background: conic-gradient({{ block.settings.prize_1_color }} 0deg 120deg, {{ block.settings.prize_2_color }} 120deg 240deg, {{ block.settings.prize_3_color }} 240deg 360deg);
    box-shadow: 0 5px 18px rgba(0, 0, 0, 0.18);
  }

  .ai-discount-roulette-{{ ai_gen_id }}__wheel::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
    background: {{ block.settings.background_color }};
    border: 5px solid {{ block.settings.accent_color }};
    border-radius: 50%;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__pointer {
    position: absolute;
    top: -7px;
    left: 50%;
    z-index: 1;
    width: 0;
    height: 0;
    transform: translateX(-50%);
    border-right: 13px solid transparent;
    border-left: 13px solid transparent;
    border-top: 28px solid {{ block.settings.accent_color }};
  }

  .ai-discount-roulette-{{ ai_gen_id }}__labels {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    pointer-events: none;
    font-size: 13px;
    font-weight: 700;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__label {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    padding: 20px;
    color: #212326;
    line-height: 1.2;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__label--one { grid-column: 1 / 3; align-items: flex-start; padding-top: 32px; }
  .ai-discount-roulette-{{ ai_gen_id }}__label--two { align-items: flex-end; padding-bottom: 34px; }
  .ai-discount-roulette-{{ ai_gen_id }}__label--three { align-items: flex-end; padding-bottom: 34px; }

  .ai-discount-roulette-{{ ai_gen_id }}__button {
    min-width: 190px;
    padding: 13px 22px;
    color: {{ block.settings.button_text_color }};
    background: {{ block.settings.button_color }};
    border: 1px solid {{ block.settings.button_color }};
    border-radius: {{ block.settings.button_radius }}px;
    cursor: pointer;
    font: inherit;
    font-weight: 700;
  }

  .ai-discount-roulette-{{ ai_gen_id }}__button:focus-visible,
  .ai-discount-roulette-{{ ai_gen_id }}__close:focus-visible { outline: 3px solid {{ block.settings.focus_color }}; outline-offset: 3px; }
  .ai-discount-roulette-{{ ai_gen_id }}__result { margin-top: 18px; font-weight: 700; }
  .ai-discount-roulette-{{ ai_gen_id }}__code { display: inline-block; margin-top: 8px; padding: 8px 12px; color: {{ block.settings.text_color }}; background: {{ block.settings.code_background }}; border: 1px dashed {{ block.settings.accent_color }}; font-weight: 700; letter-spacing: 0.08em; }
  .ai-discount-roulette-{{ ai_gen_id }}__note { margin: 14px 0 0; font-size: 12px; opacity: 0.75; }

  @media screen and (max-width: 749px) {
    .ai-discount-roulette-{{ ai_gen_id }}__modal { width: 100%; padding: 30px 18px 24px; }
    .ai-discount-roulette-{{ ai_gen_id }}__heading { font-size: 26px; }
  }
{% endstyle %}

<discount-roulette-{{ ai_gen_id }} class="ai-discount-roulette-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-discount-roulette-{{ ai_gen_id }}__backdrop" role="dialog" aria-modal="true" aria-labelledby="ai-roulette-title-{{ ai_gen_id }}">
    <div class="ai-discount-roulette-{{ ai_gen_id }}__modal">
      <button class="ai-discount-roulette-{{ ai_gen_id }}__close" type="button" aria-label="Close discount offer">&times;</button>
      <p class="ai-discount-roulette-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p>
      <h2 id="ai-roulette-title-{{ ai_gen_id }}" class="ai-discount-roulette-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2>
      <div class="ai-discount-roulette-{{ ai_gen_id }}__copy">{{ block.settings.description }}</div>
      <div class="ai-discount-roulette-{{ ai_gen_id }}__wheel-wrap">
        <span class="ai-discount-roulette-{{ ai_gen_id }}__pointer" aria-hidden="true"></span>
        <div class="ai-discount-roulette-{{ ai_gen_id }}__wheel" aria-hidden="true"></div>
        <div class="ai-discount-roulette-{{ ai_gen_id }}__labels" aria-hidden="true">
          <span class="ai-discount-roulette-{{ ai_gen_id }}__label ai-discount-roulette-{{ ai_gen_id }}__label--one">{{ block.settings.prize_1_label }}</span>
          <span class="ai-discount-roulette-{{ ai_gen_id }}__label ai-discount-roulette-{{ ai_gen_id }}__label--two">{{ block.settings.prize_2_label }}</span>
          <span class="ai-discount-roulette-{{ ai_gen_id }}__label ai-discount-roulette-{{ ai_gen_id }}__label--three">{{ block.settings.prize_3_label }}</span>
        </div>
      </div>
      <button class="ai-discount-roulette-{{ ai_gen_id }}__button" type="button">{{ block.settings.button_label }}</button>
      <div class="ai-discount-roulette-{{ ai_gen_id }}__result" hidden aria-live="polite"></div>
      <p class="ai-discount-roulette-{{ ai_gen_id }}__note">{{ block.settings.note }}</p>
    </div>
  </div>
</discount-roulette-{{ ai_gen_id }}>

<script>
  (function() {
    class DiscountRoulette{{ ai_gen_id }} extends HTMLElement {
      connectedCallback() {
        this.backdrop = this.querySelector('.ai-discount-roulette-{{ ai_gen_id }}__backdrop');
        this.modal = this.querySelector('.ai-discount-roulette-{{ ai_gen_id }}__modal');
        this.closeButton = this.querySelector('.ai-discount-roulette-{{ ai_gen_id }}__close');
        this.spinButton = this.querySelector('.ai-discount-roulette-{{ ai_gen_id }}__button');
        this.wheel = this.querySelector('.ai-discount-roulette-{{ ai_gen_id }}__wheel');
        this.result = this.querySelector('.ai-discount-roulette-{{ ai_gen_id }}__result');
        this.prizes = [
          { label: {{ block.settings.prize_1_label | json }}, code: {{ block.settings.prize_1_code | json }} },
          { label: {{ block.settings.prize_2_label | json }}, code: {{ block.settings.prize_2_code | json }} },
          { label: {{ block.settings.prize_3_label | json }}, code: {{ block.settings.prize_3_code | json }} }
        ];
        this.closeButton.addEventListener('click', () => this.close());
        this.backdrop.addEventListener('click', (event) => { if (event.target === this.backdrop) this.close(); });
        this.spinButton.addEventListener('click', () => this.spin());
        this.closeButton.focus();
      }
      close() { this.backdrop.hidden = true; }
      spin() {
        const index = Math.floor(Math.random() * this.prizes.length);
        const turns = 4 + Math.floor(Math.random() * 3);
        const angle = turns * 360 + (index * 120) + 60;
        this.wheel.style.transition = 'transform 1.2s cubic-bezier(.2,.8,.2,1)';
        this.wheel.style.transform = 'rotate(' + angle + 'deg)';
        this.spinButton.disabled = true;
        window.setTimeout(() => {
          const prize = this.prizes[index];
          this.result.innerHTML = 'You won ' + prize.label + '.<br><span class="ai-discount-roulette-{{ ai_gen_id }}__code">' + prize.code + '</span>';
          this.result.hidden = false;
          this.spinButton.hidden = true;
        }, 1250);
      }
    }
    if (!customElements.get('discount-roulette-{{ ai_gen_id }}')) customElements.define('discount-roulette-{{ ai_gen_id }}', DiscountRoulette{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Discount roulette",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A welcome gift" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Spin for a special saving" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Take a spin and receive one of our welcome offers from Softex Linens." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Spin the wheel" },
    { "type": "text", "id": "note", "label": "Note", "default": "Offer codes are subject to the terms configured in Shopify." },
    { "type": "header", "content": "Prizes" },
    { "type": "text", "id": "prize_1_label", "label": "Prize 1 label", "default": "10% off" },
    { "type": "text", "id": "prize_1_code", "label": "Prize 1 code", "default": "WELCOME10" },
    { "type": "color", "id": "prize_1_color", "label": "Prize 1 color", "default": "#faeaa1" },
    { "type": "text", "id": "prize_2_label", "label": "Prize 2 label", "default": "15% off" },
    { "type": "text", "id": "prize_2_code", "label": "Prize 2 code", "default": "WELCOME15" },
    { "type": "color", "id": "prize_2_color", "label": "Prize 2 color", "default": "#d8c58a" },
    { "type": "text", "id": "prize_3_label", "label": "Prize 3 label", "default": "Free shipping" },
    { "type": "text", "id": "prize_3_code", "label": "Prize 3 code", "default": "SHIPFREE" },
    { "type": "color", "id": "prize_3_color", "label": "Prize 3 color", "default": "#b8a46b" },
    { "type": "header", "content": "Style" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "corner_radius", "label": "Corner radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "range", "id": "button_radius", "label": "Button radius", "min": 0, "max": 40, "step": 2, "unit": "px", "default": 0 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#212326" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a1b18" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#1a1b18" },
    { "type": "color", "id": "button_color", "label": "Button", "default": "#1a1b18" },
    { "type": "color", "id": "button_text_color", "label": "Button text", "default": "#ffffff" },
    { "type": "color", "id": "border_color", "label": "Border", "default": "#d2d5d9" },
    { "type": "color", "id": "code_background", "label": "Code background", "default": "#f3f3f3" },
    { "type": "color", "id": "overlay_color", "label": "Overlay", "default": "rgba(33,35,38,0.62)" },
    { "type": "color", "id": "focus_color", "label": "Focus outline", "default": "#87adf5" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "arvo_n4" }
  ],
  "presets": [{ "name": "Discount roulette" }],
  "tag": null,
  "class": "discount-roulette-block"
}
{% endschema %}