{% doc %}
  @prompt
    Create a discount roulette spin wheel block with weighted probability odds. The wheel should have 3 prize segments: 5% off (60% chance, discount code WELCOME5, color #faeaa1), 10% off (30% chance, discount code WELCOME10, color #d8c58a), and 15% off (10% chance, discount code WELCOME15, color #b8a46b). The spin animation should land on a segment based on the weighted probability, then display the winning discount code for the customer to copy. Eyebrow: 'A welcome gift', heading: 'Spin for a special saving', description: 'Take a spin and receive one of our welcome offers from Softex Linens.', button label: 'Spin the wheel', note: 'Offer codes are subject to the terms configured in Shopify.', we need it as a ppopup
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-roulette-popup-{{ ai_gen_id }}{display:block;width:100%;}.ai-roulette-popup__trigger-{{ ai_gen_id }}{position:fixed;right:22px;bottom:22px;z-index:999;background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};border:0;border-radius:{{ block.settings.button_radius }}px;padding:14px 20px;font:inherit;font-weight:700;cursor:pointer;box-shadow:0 5px 18px #0003}.ai-roulette-popup__overlay-{{ ai_gen_id }}{position:fixed;inset:0;z-index:1000;background:#212326b8;display:none;align-items:center;justify-content:center;padding:20px}.ai-roulette-popup__overlay-{{ ai_gen_id }}.is-open{display:flex}.ai-roulette-popup__dialog-{{ ai_gen_id }}{position:relative;width:min(860px,100%);max-height:90vh;overflow:auto;background:{{ block.settings.background_color }};color:{{ block.settings.text_color }};padding:42px;border-radius:{{ block.settings.dialog_radius }}px;box-shadow:0 18px 50px #0004}.ai-roulette-popup__close-{{ ai_gen_id }}{position:absolute;right:16px;top:12px;background:none;border:0;color:{{ block.settings.heading_color }};font-size:28px;cursor:pointer}.ai-roulette-popup__inner-{{ ai_gen_id }}{display:grid;grid-template-columns:1fr 1fr;gap:38px;align-items:center}.ai-roulette-popup__copy-{{ ai_gen_id }}{text-align:{{ block.settings.alignment }}}.ai-roulette-popup__eyebrow-{{ ai_gen_id }}{color:{{ block.settings.accent_color }};font-size:12px;letter-spacing:.16em;text-transform:uppercase;font-weight:700}.ai-roulette-popup__heading-{{ ai_gen_id }}{margin:10px 0 14px;color:{{ block.settings.heading_color }};font-family:{{ block.settings.heading_font.family }};font-size:clamp(27px,4vw,43px);line-height:1.1}.ai-roulette-popup__description-{{ ai_gen_id }}{line-height:1.6}.ai-roulette-popup__note-{{ ai_gen_id }}{font-size:12px;opacity:.75;line-height:1.5}.ai-roulette-popup__spin-{{ ai_gen_id }}{background:{{ block.settings.button_color }};color:{{ block.settings.button_text_color }};border:0;border-radius:{{ block.settings.button_radius }}px;padding:13px 23px;font:inherit;font-weight:700;cursor:pointer}.ai-roulette-popup__spin:disabled{opacity:.6}.ai-roulette-popup__wheel-wrap-{{ ai_gen_id }}{position:relative;width:min(100%,330px);aspect-ratio:1;margin:auto}.ai-roulette-popup__wheel-{{ ai_gen_id }}{width:100%;height:100%;border:8px solid {{ block.settings.wheel_border_color }};border-radius:50%;background:conic-gradient(from -30deg,{{ block.settings.segment_one_color }} 0 216deg,{{ block.settings.segment_two_color }} 216deg 324deg,{{ block.settings.segment_three_color }} 324deg 360deg);transition:transform 4s cubic-bezier(.12,.72,.15,1);box-shadow:0 8px 22px #21232629}.ai-roulette-popup__pointer-{{ ai_gen_id }}{position:absolute;z-index:2;top:-12px;left:50%;transform:translateX(-50%);border-left:14px solid transparent;border-right:14px solid transparent;border-top:28px solid {{ block.settings.pointer_color }}}.ai-roulette-popup__labels-{{ ai_gen_id }}{position:absolute;inset:0;pointer-events:none}.ai-roulette-popup__label-{{ ai_gen_id }}{position:absolute;left:50%;top:50%;width:32%;transform-origin:0 0;text-align:center;font-weight:700;font-size:14px;color:#212326}.ai-roulette-popup__label--one-{{ ai_gen_id }}{transform:rotate(48deg) translate(66px,-50%)}.ai-roulette-popup__label--two-{{ ai_gen_id }}{transform:rotate(264deg) translate(66px,-50%)}.ai-roulette-popup__label--three-{{ ai_gen_id }}{transform:rotate(336deg) translate(66px,-50%)}.ai-roulette-popup__result-{{ ai_gen_id }}{min-height:54px;text-align:center;margin-top:18px}.ai-roulette-popup__code-{{ ai_gen_id }}{display:inline-block;padding:8px 12px;border:1px dashed {{ block.settings.accent_color }};font-weight:700;letter-spacing:.08em}.ai-roulette-popup__copy-{{ ai_gen_id }}{margin-left:8px;border:0;background:none;text-decoration:underline;cursor:pointer;color:{{ block.settings.heading_color }};font:inherit;font-size:13px}@media(max-width:749px){.ai-roulette-popup__dialog-{{ ai_gen_id }}{padding:38px 22px}.ai-roulette-popup__inner-{{ ai_gen_id }}{grid-template-columns:1fr;gap:25px}.ai-roulette-popup__copy-{{ ai_gen_id }}{text-align:center}}
{% endstyle %}
<discount-roulette-popup-{{ ai_gen_id }} class="ai-roulette-popup-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
<button class="ai-roulette-popup__trigger-{{ ai_gen_id }}" type="button" aria-haspopup="dialog">{{ block.settings.trigger_label }}</button>
<div class="ai-roulette-popup__overlay-{{ ai_gen_id }}" role="dialog" aria-modal="true" aria-label="{{ block.settings.heading | escape }}"><div class="ai-roulette-popup__dialog-{{ ai_gen_id }}"><button class="ai-roulette-popup__close-{{ ai_gen_id }}" type="button" aria-label="Close">&times;</button><div class="ai-roulette-popup__inner-{{ ai_gen_id }}"><div class="ai-roulette-popup__copy-{{ ai_gen_id }}"><p class="ai-roulette-popup__eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</p><h2 class="ai-roulette-popup__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2><p>{{ block.settings.description }}</p><button class="ai-roulette-popup__spin-{{ ai_gen_id }}" type="button">{{ block.settings.button_label }}</button><p class="ai-roulette-popup__note-{{ ai_gen_id }}">{{ block.settings.note }}</p></div><div><div class="ai-roulette-popup__wheel-wrap-{{ ai_gen_id }}"><div class="ai-roulette-popup__pointer-{{ ai_gen_id }}"></div><div class="ai-roulette-popup__wheel-{{ ai_gen_id }}"></div><div class="ai-roulette-popup__labels-{{ ai_gen_id }}"><span class="ai-roulette-popup__label-{{ ai_gen_id }} ai-roulette-popup__label--one-{{ ai_gen_id }}">{{ block.settings.prize_one }}</span><span class="ai-roulette-popup__label-{{ ai_gen_id }} ai-roulette-popup__label--two-{{ ai_gen_id }}">{{ block.settings.prize_two }}</span><span class="ai-roulette-popup__label-{{ ai_gen_id }} ai-roulette-popup__label--three-{{ ai_gen_id }}">{{ block.settings.prize_three }}</span></div></div><div class="ai-roulette-popup__result-{{ ai_gen_id }}" aria-live="polite"></div></div></div></div></div></div>
</discount-roulette-popup-{{ ai_gen_id }}>
<script>(function(){class Roulette{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.trigger=this.querySelector('.ai-roulette-popup__trigger-{{ ai_gen_id }}');this.overlay=this.querySelector('.ai-roulette-popup__overlay-{{ ai_gen_id }}');this.close=this.querySelector('.ai-roulette-popup__close-{{ ai_gen_id }}');this.spinButton=this.querySelector('.ai-roulette-popup__spin-{{ ai_gen_id }}');this.wheel=this.querySelector('.ai-roulette-popup__wheel-{{ ai_gen_id }}');this.result=this.querySelector('.ai-roulette-popup__result-{{ ai_gen_id }}');this.rotation=0;this.trigger.onclick=()=>{this.overlay.classList.add('is-open');this.close.focus()};this.close.onclick=()=>this.overlay.classList.remove('is-open');this.overlay.onclick=e=>{if(e.target===this.overlay)this.overlay.classList.remove('is-open')};this.spinButton.onclick=()=>this.spin()}spin(){if(this.spinButton.disabled)return;this.spinButton.disabled=true;let n=Math.random()*100,p,c;let w1={{ block.settings.prize_one_weight }},w2={{ block.settings.prize_two_weight }};if(n<w1){p='{{ block.settings.prize_one | escape }}';c='{{ block.settings.prize_one_code | escape }}';this.target=108}else if(n<w1+w2){p='{{ block.settings.prize_two | escape }}';c='{{ block.settings.prize_two_code | escape }}';this.target=270}else{p='{{ block.settings.prize_three | escape }}';c='{{ block.settings.prize_three_code | escape }}';this.target=342}this.rotation+=1440+(360-((this.rotation+this.target)%360));this.wheel.style.transform='rotate('+this.rotation+'deg)';setTimeout(()=>{this.result.innerHTML='<strong>You won '+p+'!</strong><br><span class="ai-roulette-popup__code-{{ ai_gen_id }}">'+c+'</span><button class="ai-roulette-popup__copy-{{ ai_gen_id }}" type="button">Copy code</button>';this.result.querySelector('button').onclick=()=>navigator.clipboard.writeText(c);this.spinButton.disabled=false},4100)}}customElements.define('discount-roulette-popup-{{ ai_gen_id }}',Roulette{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Discount roulette popup","settings":[{"type":"text","id":"trigger_label","label":"Trigger label","default":"Spin to win"},{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A welcome gift"},{"type":"text","id":"heading","label":"Heading","default":"Spin for a special saving"},{"type":"textarea","id":"description","label":"Description","default":"Take a spin and receive one of our welcome offers from Softex Linens."},{"type":"text","id":"button_label","label":"Button label","default":"Spin the wheel"},{"type":"textarea","id":"note","label":"Note","default":"Offer codes are subject to the terms configured in Shopify."},{"type":"header","content":"Offers"},{"type":"text","id":"prize_one","label":"First prize","default":"5% off"},{"type":"text","id":"prize_one_code","label":"First code","default":"WELCOME5"},{"type":"range","id":"prize_one_weight","label":"First chance","min":0,"max":100,"step":5,"unit":"%","default":60},{"type":"color","id":"segment_one_color","label":"First segment","default":"#faeaa1"},{"type":"text","id":"prize_two","label":"Second prize","default":"10% off"},{"type":"text","id":"prize_two_code","label":"Second code","default":"WELCOME10"},{"type":"range","id":"prize_two_weight","label":"Second chance","min":0,"max":100,"step":5,"unit":"%","default":30},{"type":"color","id":"segment_two_color","label":"Second segment","default":"#d8c58a"},{"type":"text","id":"prize_three","label":"Third prize","default":"15% off"},{"type":"text","id":"prize_three_code","label":"Third code","default":"WELCOME15"},{"type":"range","id":"prize_three_weight","label":"Third chance","min":0,"max":100,"step":5,"unit":"%","default":10},{"type":"color","id":"segment_three_color","label":"Third segment","default":"#b8a46b"},{"type":"header","content":"Style"},{"type":"select","id":"alignment","label":"Alignment","options":[{"value":"left","label":"Left"},{"value":"center","label":"Center"}],"default":"left"},{"type":"font_picker","id":"heading_font","label":"Heading font","default":"arvo_n4"},{"type":"color","id":"background_color","label":"Background","default":"#ffffff"},{"type":"color","id":"text_color","label":"Text","default":"#212326"},{"type":"color","id":"heading_color","label":"Heading","default":"#1a1b18"},{"type":"color","id":"accent_color","label":"Accent","default":"#1a1b18"},{"type":"color","id":"button_color","label":"Button","default":"#1a1b18"},{"type":"color","id":"button_text_color","label":"Button text","default":"#ffffff"},{"type":"color","id":"wheel_border_color","label":"Wheel border","default":"#1a1b18"},{"type":"color","id":"pointer_color","label":"Pointer","default":"#1a1b18"},{"type":"range","id":"button_radius","label":"Button radius","min":0,"max":40,"step":2,"unit":"px","default":0},{"type":"range","id":"dialog_radius","label":"Popup radius","min":0,"max":40,"step":2,"unit":"px","default":8}],"presets":[{"name":"Discount roulette popup"}],"tag":null,"class":"discount-roulette-popup-block"}{% endschema %}