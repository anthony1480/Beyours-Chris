{% doc %}
  @prompt
    Create a discount roulette spin wheel block with weighted probability odds. The wheel should have 3 prize segments: 5% off (60% chance, discount code WELCOME5, color #faeaa1), 10% off (30% chance, discount code WELCOME10, color #d8c58a), and 15% off (10% chance, discount code WELCOME15, color #b8a46b). The spin animation should land on a segment based on the weighted probability, then display the winning discount code for the customer to copy. Eyebrow: 'A welcome gift', heading: 'Spin for a special saving', description: 'Take a spin and receive one of our welcome offers from Softex Linens.', button label: 'Spin the wheel', note: 'Offer codes are subject to the terms configured in Shopify.', we need it as a ppopup, we need it to appear when peopleopen the website, okay justt make it a  roulette and the arrow fixed on the top and the thing that lands on the top is the discount and hide the odds, okay keep everything as it is but remove whats inside the roulette, okay make 3 equal pieces inside the roulette , great now put the reward and the code on top of the roulette, make 6 equal rewards
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-wheel-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;font-family:Arial,sans-serif;color:#212326}.ai-wheel-{{ ai_gen_id }}__button{background:#1a1b18;color:#fff;border:0;padding:14px 24px;cursor:pointer}.ai-wheel-{{ ai_gen_id }}__modal{display:none;position:fixed;inset:0;background:rgba(0,0,0,.55);z-index:9999;align-items:center;justify-content:center;padding:20px}.ai-wheel-{{ ai_gen_id }}__modal.is-open{display:flex}.ai-wheel-{{ ai_gen_id }}__panel{background:#fff;max-width:430px;width:100%;padding:28px;text-align:center;position:relative}.ai-wheel-{{ ai_gen_id }}__close{position:absolute;right:12px;top:8px;border:0;background:none;font-size:24px;cursor:pointer}.ai-wheel-{{ ai_gen_id }}__result{min-height:70px;font-weight:bold;margin-bottom:12px}.ai-wheel-{{ ai_gen_id }}__stage{position:relative;width:280px;height:280px;margin:20px auto}.ai-wheel-{{ ai_gen_id }}__pointer{position:absolute;z-index:2;top:-12px;left:50%;transform:translateX(-50%);width:0;height:0;border-left:14px solid transparent;border-right:14px solid transparent;border-top:28px solid #1a1b18}.ai-wheel-{{ ai_gen_id }}__disc{width:100%;height:100%;border-radius:50%;background:conic-gradient(#faeaa1 0deg 60deg,#d8c58a 60deg 120deg,#b8a46b 120deg 180deg,#faeaa1 180deg 240deg,#d8c58a 240deg 300deg,#b8a46b 300deg 360deg);border:8px solid #1a1b18;transition:transform 4s cubic-bezier(.12,.75,.2,1)}.ai-wheel-{{ ai_gen_id }}__disc:after{content:'';position:absolute;inset:42%;background:#1a1b18;border-radius:50%}.ai-wheel-{{ ai_gen_id }}__copy{display:none;margin-top:10px}.ai-wheel-{{ ai_gen_id }}__copy.is-visible{display:inline-block}
{% endstyle %}
<discount-wheel-{{ ai_gen_id }} class="ai-wheel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
<button class="ai-wheel-{{ ai_gen_id }}__button" type="button">{{ block.settings.trigger_label }}</button>
<div class="ai-wheel-{{ ai_gen_id }}__modal" role="dialog" aria-modal="true" aria-label="{{ block.settings.heading | escape }}"><div class="ai-wheel-{{ ai_gen_id }}__panel"><button class="ai-wheel-{{ ai_gen_id }}__close" type="button" aria-label="Close">&times;</button><p>{{ block.settings.eyebrow }}</p><h2>{{ block.settings.heading }}</h2><p>{{ block.settings.description }}</p><div class="ai-wheel-{{ ai_gen_id }}__result" aria-live="polite"></div><div class="ai-wheel-{{ ai_gen_id }}__stage"><div class="ai-wheel-{{ ai_gen_id }}__pointer"></div><div class="ai-wheel-{{ ai_gen_id }}__disc"></div></div><button class="ai-wheel-{{ ai_gen_id }}__spin" type="button">{{ block.settings.spin_label }}</button><button class="ai-wheel-{{ ai_gen_id }}__copy" type="button">Copy code</button><small>{{ block.settings.note }}</small></div></div>
</discount-wheel-{{ ai_gen_id }}>
<script>(function(){class Wheel{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.modal=this.querySelector('.ai-wheel-{{ ai_gen_id }}__modal');this.disc=this.querySelector('.ai-wheel-{{ ai_gen_id }}__disc');this.result=this.querySelector('.ai-wheel-{{ ai_gen_id }}__result');this.copy=this.querySelector('.ai-wheel-{{ ai_gen_id }}__copy');this.code='';this.querySelector('.ai-wheel-{{ ai_gen_id }}__button').onclick=()=>this.modal.classList.add('is-open');this.querySelector('.ai-wheel-{{ ai_gen_id }}__close').onclick=()=>this.modal.classList.remove('is-open');this.querySelector('.ai-wheel-{{ ai_gen_id }}__spin').onclick=()=>this.spin();this.copy.onclick=()=>navigator.clipboard&&navigator.clipboard.writeText(this.code)}spin(){let n=Math.floor(Math.random()*6), rewards=['5% off','10% off','15% off','5% off','10% off','15% off'],codes=['WELCOME5','WELCOME10','WELCOME15','WELCOME5','WELCOME10','WELCOME15'];this.code=codes[n];this.disc.style.transform='rotate('+(1440+(360-n*60-30))+'deg)';setTimeout(()=>{this.result.textContent=rewards[n]+' — '+this.code;this.copy.classList.add('is-visible')},4100)}}customElements.define('discount-wheel-{{ ai_gen_id }}',Wheel{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Discount roulette","tag":null,"class":"discount-roulette-block","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A welcome gift"},{"type":"text","id":"heading","label":"Heading","default":"Spin for a special saving"},{"type":"textarea","id":"description","label":"Description","default":"Take a spin and receive one of our welcome offers from Softex Linens."},{"type":"text","id":"trigger_label","label":"Open button","default":"Open roulette"},{"type":"text","id":"spin_label","label":"Spin button","default":"Spin the wheel"},{"type":"text","id":"note","label":"Note","default":"Offer codes are subject to the terms configured in Shopify."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Discount roulette"}]}{% endschema %}