 the thing that lands on the top is the discount and hide the odds, okay keep everything as it is but remove whats inside the roulette, okay make 3 equal pieces inside the roulette , great now put the reward and the code on top of the roulette, make 6 equal rewards, make it appear the second people open the website
    
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% style %}
.ai-roulette-{{ ai_gen_id }}{display:block;width:{{ block.settings.desktop_width_percent }}%;max-width:100%;font-family:Arial,sans-serif;color:#212326}.ai-roulette-{{ ai_gen_id }}__trigger{background:#1a1b18;color:#fff;border:0;padding:14px 24px;cursor:pointer}.ai-roulette-{{ ai_gen_id }}__overlay{display:none;position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,.58);align-items:center;justify-content:center;padding:20px}.ai-roulette-{{ ai_gen_id }}__overlay.is-open{display:flex}.ai-roulette-{{ ai_gen_id }}__panel{position:relative;width:100%;max-width:430px;padding:28px;background:#fff;text-align:center}.ai-roulette-{{ ai_gen_id }}__close{position:absolute;right:12px;top:8px;border:0;background:none;font-size:25px;cursor:pointer;color:#212326}.ai-roulette-{{ ai_gen_id }}__eyebrow{margin:0 0 8px}.ai-roulette-{{ ai_gen_id }}__heading{margin:0 0 8px;color:#1a1b18}.ai-roulette-{{ ai_gen_id }}__description{margin:0 0 16px}.ai-roulette-{{ ai_gen_id }}__result{min-height:62px;margin:0 0 8px;font-size:20px;font-weight:700;color:#1a1b18}.ai-roulette-{{ ai_gen_id }}__stage{position:relative;width:280px;height:280px;margin:0 auto 20px}.ai-roulette-{{ ai_gen_id }}__pointer{position:absolute;top:-13px;left:50%;z-index:2;transform:translateX(-50%);width:0;height:0;border-left:15px solid transparent;border-right:15px solid transparent;border-top:30px solid #1a1b18}.ai-roulette-{{ ai_gen_id }}__wheel{width:100%;height:100%;border:8px solid #1a1b18;border-radius:50%;background:conic-gradient(#faeaa1 0deg 60deg,#d8c58a 60deg 120deg,#b8a46b 120deg 180deg,#faeaa1 180deg 240deg,#d8c58a 240deg 300deg,#b8a46b 300deg 360deg);transition:transform 4s cubic-bezier(.12,.75,.2,1)}.ai-roulette-{{ ai_gen_id }}__hub{position:absolute;inset:43%;z-index:1;border-radius:50%;background:#1a1b18}.ai-roulette-{{ ai_gen_id }}__spin{background:#1a1b18;color:#fff;border:0;padding:14px 24px;cursor:pointer}.ai-roulette-{{ ai_gen_id }}__copy{display:none;margin:12px 0 0;background:#faeaa1;color:#212326;border:1px solid #1a1b18;padding:10px 16px;cursor:pointer}.ai-roulette-{{ ai_gen_id }}__copy.is-visible{display:inline-block}.ai-roulette-{{ ai_gen_id }}__note{display:block;margin-top:16px;font-size:12px}@media(max-width:480px){.ai-roulette-{{ ai_gen_id }}__stage{width:240px;height:240px}}
{% endstyle %}
<discount-roulette-{{ ai_gen_id }} class="ai-roulette-{{ ai_gen_id }}" {{ block.shopify_attributes }}><button class="ai-roulette-{{ ai_gen_id }}__trigger" type="button">{{ block.settings.open_label }}</button><div class="ai-roulette-{{ ai_gen_id }}__overlay" role="dialog" aria-modal="true" aria-label="{{ block.settings.heading | escape }}"><div class="ai-roulette-{{ ai_gen_id }}__panel"><button class="ai-roulette-{{ ai_gen_id }}__close" type="button" aria-label="Close">&times;</button><p class="ai-roulette-{{ ai_gen_id }}__eyebrow">{{ block.settings.eyebrow }}</p><h2 class="ai-roulette-{{ ai_gen_id }}__heading">{{ block.settings.heading }}</h2><p class="ai-roulette-{{ ai_gen_id }}__description">{{ block.settings.description }}</p><div class="ai-roulette-{{ ai_gen_id }}__result" aria-live="polite"></div><div class="ai-roulette-{{ ai_gen_id }}__stage"><div class="ai-roulette-{{ ai_gen_id }}__pointer"></div><div class="ai-roulette-{{ ai_gen_id }}__wheel"></div><div class="ai-roulette-{{ ai_gen_id }}__hub"></div></div><button class="ai-roulette-{{ ai_gen_id }}__spin" type="button">{{ block.settings.spin_label }}</button><button class="ai-roulette-{{ ai_gen_id }}__copy" type="button">Copy code</button><small class="ai-roulette-{{ ai_gen_id }}__note">{{ block.settings.note }}</small></div></div></discount-roulette-{{ ai_gen_id }}>
<script>(function(){class Roulette{{ ai_gen_id }} extends HTMLElement{connectedCallback(){this.overlay=this.querySelector('.ai-roulette-{{ ai_gen_id }}__overlay');this.wheel=this.querySelector('.ai-roulette-{{ ai_gen_id }}__wheel');this.result=this.querySelector('.ai-roulette-{{ ai_gen_id }}__result');this.copy=this.querySelector('.ai-roulette-{{ ai_gen_id }}__copy');this.code='';this.querySelector('.ai-roulette-{{ ai_gen_id }}__trigger').addEventListener('click',()=>this.overlay.classList.add('is-open'));this.querySelector('.ai-roulette-{{ ai_gen_id }}__close').addEventListener('click',()=>this.overlay.classList.remove('is-open'));this.querySelector('.ai-roulette-{{ ai_gen_id }}__spin').addEventListener('click',()=>this.spin());this.copy.addEventListener('click',()=>{if(navigator.clipboard){navigator.clipboard.writeText(this.code);this.copy.textContent='Copied'}});if(!sessionStorage.getItem('ai-roulette-open-{{ ai_gen_id }}')){sessionStorage.setItem('ai-roulette-open-{{ ai_gen_id }}','1');this.overlay.classList.add('is-open')}}spin(){var random=Math.random(),reward,code;if(random<.6){reward='5% off';code='WELCOME5'}else if(random<.9){reward='10% off';code='WELCOME10'}else{reward='15% off';code='WELCOME15'}var target=Math.floor(Math.random()*360),turns=1440+target;this.wheel.style.transform='rotate('+turns+'deg)';this.result.textContent='';this.copy.classList.remove('is-visible');setTimeout(()=>{this.result.textContent=reward+' — '+code;this.code=code;this.copy.classList.add('is-visible')},4100)}}customElements.define('discount-roulette-{{ ai_gen_id }}',Roulette{{ ai_gen_id }})})();</script>
{% schema %}{"name":"Discount roulette","tag":null,"class":"discount-roulette-block","settings":[{"type":"text","id":"eyebrow","label":"Eyebrow","default":"A welcome gift"},{"type":"text","id":"heading","label":"Heading","default":"Spin for a special saving"},{"type":"textarea","id":"description","label":"Description","default":"Take a spin and receive one of our welcome offers from Softex Linens."},{"type":"text","id":"open_label","label":"Open button","default":"Open roulette"},{"type":"text","id":"spin_label","label":"Spin button","default":"Spin the wheel"},{"type":"text","id":"note","label":"Note","default":"Offer codes are subject to the terms configured in Shopify."},{"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}],"presets":[{"name":"Discount roulette"}]}{% endschema %}