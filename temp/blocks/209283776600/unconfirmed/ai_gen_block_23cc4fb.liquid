{% doc %}
  @prompt
    On the product collection/listing page, ensure that a discount percentage badge (e.g. "-30%") is displayed on ALL product cards that have a compare-at price higher than the current price. The badge should appear consistently on mobile and desktop, positioned on the product image (top left corner), with a red background and white text. The percentage should be calculated dynamically as: round((compare_at_price - price) / compare_at_price * 100). Currently some products are missing the badge even though they have a discounted price — fix this so it shows on every discounted product card including those with "From" pricing (multiple variants).
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% liquid
  assign has_discount = false
  assign discount_percentage = 0
  
  if product.compare_at_price_max > product.price_max
    assign has_discount = true
    assign price_diff = product.compare_at_price_max | minus: product.price_max
    assign discount_percentage = price_diff | times: 100.0 | divided_by: product.compare_at_price_max | round
  elsif product.compare_at_price_min > product.price_min
    assign has_discount = true
    assign price_diff = product.compare_at_price_min | minus: product.price_min
    assign discount_percentage = price_diff | times: 100.0 | divided_by: product.compare_at_price_min | round
  endif
%}

{% if has_discount %}
  {% style %}
    .ai-discount-badge-{{ ai_gen_id }} {
      position: absolute;
      top: {{ block.settings.badge_top_offset }}px;
      left: {{ block.settings.badge_left_offset }}px;
      z-index: 10;
      background-color: {{ block.settings.badge_background_color }};
      color: {{ block.settings.badge_text_color }};
      font-size: {{ block.settings.badge_font_size }}px;
      font-weight: {{ block.settings.badge_font_weight }};
      padding: {{ block.settings.badge_padding_vertical }}px {{ block.settings.badge_padding_horizontal }}px;
      border-radius: {{ block.settings.badge_border_radius }}px;
      line-height: 1;
      display: block;
    }

    @media screen and (max-width: 749px) {
      .ai-discount-badge-{{ ai_gen_id }} {
        font-size: {{ block.settings.badge_font_size | times: 0.9 }}px;
        padding: {{ block.settings.badge_padding_vertical | times: 0.9 }}px {{ block.settings.badge_padding_horizontal | times: 0.9 }}px;
      }
    }
  {% endstyle %}

  <span class="ai-discount-badge-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    -{{ discount_percentage }}%
  </span>
{% endif %}

{% schema %}
{
