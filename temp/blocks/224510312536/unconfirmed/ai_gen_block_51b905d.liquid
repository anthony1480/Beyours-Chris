{% doc %}
  @prompt
    product grid
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-product-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    margin: 0 auto;
    color: {{ block.settings.text_color }};
  }

  .ai-product-grid-{{ ai_gen_id }}__heading {
    margin: 0 0 24px;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font.family }};
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_font.weight }};
    text-align: {{ block.settings.alignment }};
  }

  .ai-product-grid-{{ ai_gen_id }}__items {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, minmax(0, 1fr));
    gap: {{ block.settings.gap }}px;
  }

  .ai-product-grid-{{ ai_gen_id }}__card {
    min-width: 0;
    text-align: {{ block.settings.card_alignment }};
  }

  .ai-product-grid-{{ ai_gen_id }}__image-link {
    display: block;
    overflow: hidden;
    background: {{ block.settings.image_background }};
    border-radius: {{ block.settings.card_radius }}px;
    aspect-ratio: 1 / 1;
  }

  .ai-product-grid-{{ ai_gen_id }}__image-link img,
  .ai-product-grid-{{ ai_gen_id }}__placeholder svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-product-grid-{{ ai_gen_id }}__placeholder {
    width: 100%;
    height: 100%;
  }

  .ai-product-grid-{{ ai_gen_id }}__details {
    padding-top: 14px;
  }

  .ai-product-grid-{{ ai_gen_id }}__title {
    display: block;
    margin: 0 0 7px;
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.title_size }}px;
    line-height: 1.35;
    text-decoration: none;
  }

  .ai-product-grid-{{ ai_gen_id }}__title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ai-product-grid-{{ ai_gen_id }}__price {
    color: {{ block.settings.price_color }};
    font-family: {{ block.settings.price_font.family }};
    font-size: {{ block.settings.price_size }}px;
  }

  .ai-product-grid-{{ ai_gen_id }}__compare {
    margin-left: 6px;
    color: {{ block.settings.muted_color }};
    text-decoration: line-through;
  }

  .ai-product-grid-{{ ai_gen_id }}__empty {
    padding: 36px 20px;
    background: {{ block.settings.image_background }};
    color: {{ block.settings.muted_color }};
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    .ai-product-grid-{{ ai_gen_id }}__items {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, minmax(0, 1fr));
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-product-grid-{{ ai_gen_id }}__heading {
      font-size: {{ block.settings.heading_size | times: 0.85 }}px;
    }
  }
{% endstyle %}

<div class="ai-product-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.heading != blank %}
    <h2 class="ai-product-grid-{{ ai_gen_id }}__heading">{{ block.settings.heading | escape }}</h2>
  {% endif %}

  {% if block.settings.products != blank %}
    <div class="ai-product-grid-{{ ai_gen_id }}__items">
      {% for product in block.settings.products %}
        <article class="ai-product-grid-{{ ai_gen_id }}__card">
          <a class="ai-product-grid-{{ ai_gen_id }}__image-link" href="{{ product.url }}" aria-label="View {{ product.title | escape }}">
            {% if product.featured_image %}
              <img src="{{ product.featured_image | image_url: width: 900 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" loading="lazy" width="{{ product.featured_image.width }}" height="{{ product.featured_image.height }}">
            {% else %}
              <div class="ai-product-grid-{{ ai_gen_id }}__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
            {% endif %}
          </a>
          <div class="ai-product-grid-{{ ai_gen_id }}__details">
            <a class="ai-product-grid-{{ ai_gen_id }}__title" href="{{ product.url }}">{{ product.title | escape }}</a>
            <div class="ai-product-grid-{{ ai_gen_id }}__price">
              {{ product.price | money }}
              {% if product.compare_at_price > product.price %}<span class="ai-product-grid-{{ ai_gen_id }}__compare">{{ product.compare_at_price | money }}</span>{% endif %}
            </div>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <div class="ai-product-grid-{{ ai_gen_id }}__empty">Select products to display in this grid.</div>
  {% endif %}
</div>

{% schema %}
{
  "name": "Product grid",
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured products" },
    { "type": "product_list", "id": "products", "label": "Products", "limit": 12 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "desktop_width_percent", "label": "Desktop width", "min": 50, "max": 100, "step": 5, "unit": "%", "default": 100 },
    { "type": "range", "id": "columns_desktop", "label": "Columns on desktop", "min": 2, "max": 6, "step": 1, "default": 4 },
    { "type": "select", "id": "columns_mobile", "label": "Columns on mobile", "options": [{ "value": "1", "label": "1" }, { "value": "2", "label": "2" }], "default": "2" },
    { "type": "range", "id": "gap", "label": "Desktop gap", "min": 8, "max": 48, "step": 4, "unit": "px", "default": 24 },
    { "type": "range", "id": "mobile_gap", "label": "Mobile gap", "min": 8, "max": 32, "step": 4, "unit": "px", "default": 16 },
    { "type": "select", "id": "alignment", "label": "Heading alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "select", "id": "card_alignment", "label": "Card alignment", "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }], "default": "left" },
    { "type": "header", "content": "Style" },
    { "type": "font_picker", "id": "heading_font", "label": "Heading font", "default": "arvo_n4" },
    { "type": "font_picker", "id": "price_font", "label": "Price font", "default": "arvo_n4" },
    { "type": "range", "id": "heading_size", "label": "Heading size", "min": 18, "max": 48, "step": 2, "unit": "px", "default": 30 },
    { "type": "range", "id": "title_size", "label": "Title size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "price_size", "label": "Price size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 15 },
    { "type": "range", "id": "card_radius", "label": "Image corner radius", "min": 0, "max": 24, "step": 2, "unit": "px", "default": 0 },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#1a1b18" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#212326" },
    { "type": "color", "id": "price_color", "label": "Price", "default": "#1a1b18" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#5f6368" },
    { "type": "color", "id": "image_background", "label": "Image background", "default": "#f3f3f3" }
  ],
  "presets": [{ "name": "Product grid" }],
  "tag": null,
  "class": "product-grid-block"
}
{% endschema %}