{% doc %}
  @prompt
    Create a floating WhatsApp chat button fixed to the bottom-right corner of the screen on desktop and mobile, staying visible while scrolling. Use the recognizable green WhatsApp icon and an accessible editable label 'Chat on WhatsApp'. Provide editable settings for the WhatsApp international phone number, optional prefilled message, and bottom/right spacing. Keep it clear of other chat widgets and mobile controls. Leave the phone number unset for the merchant to enter rather than using a fake number. This should be a floating button, not a footer social icon., MOVE IT TO THE RIGHT SIDE
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}
{% assign whatsapp_number = block.settings.phone_number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' %}

{% style %}
  .ai-whatsapp-float-{{ ai_gen_id }} {
    display: flex;
    justify-content: flex-end;
    position: fixed;
    right: {{ block.settings.right_spacing }}px;
    bottom: calc({{ block.settings.bottom_spacing }}px + env(safe-area-inset-bottom, 0px));
    z-index: 9999;
    width: {{ block.settings.desktop_width_percent }}vw;
    max-width: calc(100vw - {{ block.settings.right_spacing }}px);
    pointer-events: none;
  }
  .ai-whatsapp-float-{{ ai_gen_id }} .ai-whatsapp-float__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 52px;
    padding: 12px 18px;
    border: 2px solid #075e36;
    border-radius: 999px;
    background-color: #128c4a;
    color: #fff;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.25;
    text-decoration: none;
    box-shadow: 0 3px 12px rgba(0, 0, 0, .22);
    transition: background-color 160ms ease, box-shadow 160ms ease;
    pointer-events: auto;
  }
  .ai-whatsapp-float-{{ ai_gen_id }} .ai-whatsapp-float__link:hover { background-color: #075e36; }
  .ai-whatsapp-float-{{ ai_gen_id }} .ai-whatsapp-float__link:focus-visible { outline: 3px solid #1a1b18; outline-offset: 4px; }
  .ai-whatsapp-float-{{ ai_gen_id }} .ai-whatsapp-float__icon { display: block; width: 24px; height: 24px; flex: 0 0 24px; fill: currentColor; }
  @media screen and (max-width: 749px) {
    .ai-whatsapp-float-{{ ai_gen_id }} { right: max({{ block.settings.right_spacing }}px, 16px); bottom: calc(max({{ block.settings.bottom_spacing }}px, 76px) + env(safe-area-inset-bottom, 0px)); width: auto; max-width: calc(100vw - 32px); }
    .ai-whatsapp-float-{{ ai_gen_id }} .ai-whatsapp-float__link { min-height: 50px; padding: 11px 15px; font-size: 14px; }
  }
{% endstyle %}

{% if whatsapp_number != blank %}
  {% assign whatsapp_link = 'https://wa.me/' | append: whatsapp_number %}
  {% if block.settings.prefilled_message != blank %}
    {% assign encoded_message = block.settings.prefilled_message | url_encode %}
    {% assign whatsapp_link = whatsapp_link | append: '?text=' | append: encoded_message %}
  {% endif %}
  <div class="ai-whatsapp-float-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
    <a class="ai-whatsapp-float__link" href="{{ whatsapp_link }}" target="_blank" rel="noopener noreferrer" aria-label="{{ block.settings.button_label | escape }}">
      <svg class="ai-whatsapp-float__icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20.52 3.48A11.86 11.86 0 0 0 12.08 0C5.5 0 .14 5.35.14 11.94c0 2.1.55 4.15 1.6 5.96L.04 24l6.25-1.64a11.9 11.9 0 0 0 5.78 1.47h.01c6.58 0 11.94-5.36 11.94-11.94 0-3.19-1.24-6.18-3.5-8.41ZM12.08 21.8h-.01a9.86 9.86 0 0 1-5.02-1.37l-.36-.21-3.71.97.99-3.62-.24-.37a9.87 9.87 0 0 1-1.52-5.26c0-5.45 4.44-9.89 9.9-9.89a9.82 9.82 0 0 1 7 2.9 9.82 9.82 0 0 1 2.9 7c0 5.45-4.44 9.89-9.93 9.89Zm5.43-7.41c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.17-.17.2-.35.22-.65.07-.3-.15-1.26-.47-2.4-1.48-.89-.79-1.49-1.77-1.66-2.07-.17-.3-.02-.46.13-.61.14-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.62-.92-2.22-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.49s1.07 2.89 1.22 3.09c.15.2 2.1 3.2 5.08 4.49.71.31 1.26.5 1.69.64.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.7.25-1.3.17-1.42-.07-.12-.27-.2-.57-.35Z"/>
      </svg>
      <span>{{ block.settings.button_label | escape }}</span>
    </a>
  </div>
{% endif %}

{% schema %}
{
  "name": "WhatsApp chat button",
  "settings": [
    {"type":"text","id":"phone_number","label":"WhatsApp number","info":"Enter the international number with country code, digits only. Example format: 961XXXXXXXX."},
    {"type":"text","id":"prefilled_message","label":"Prefilled message"},
    {"type":"text","id":"button_label","label":"Button label","default":"Chat on WhatsApp"},
    {"type":"range","id":"bottom_spacing","label":"Bottom spacing","min":0,"max":200,"step":5,"unit":"px","default":25},
    {"type":"range","id":"right_spacing","label":"Right spacing","min":0,"max":100,"step":5,"unit":"px","default":25},
    {"type":"range","id":"desktop_width_percent","label":"Desktop width","min":50,"max":100,"step":5,"unit":"%","default":100}
  ],
  "presets": [{"name":"WhatsApp chat button"}],
  "tag": null,
  "class": "whatsapp-chat-button"
}
{% endschema %}